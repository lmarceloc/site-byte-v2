{
  "outputDirectory": ".",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agenciabyte.com"
        }
      ],
      "destination": "https://agenciabyte.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "statusCode": 301
    },
    {
      "source": "/processo",
      "destination": "/#processo",
      "statusCode": 301
    },
    {
      "source": "/stack",
      "destination": "/servicos",
      "statusCode": 301
    }
  ]
}
