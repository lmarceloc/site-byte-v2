{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-byte-v2",
  "compatibility_date": "2026-10-01",
  // Site estático servido pelos Static Assets. O worker.js só atende /rb/*
  // (proxy do PostHog, ver run_worker_first); o resto nunca passa por ele.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/rb/*"],
    // /servicos/ -> /servicos (equivale ao trailingSlash: false da Vercel)
    "html_handling": "drop-trailing-slash",
    // Rotas inexistentes servem 404.html com status 404
    "not_found_handling": "404-page"
  },
  // Evita conteúdo duplicado indexado em *.workers.dev / URLs de preview
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "agenciabyte.com", "custom_domain": true },
    { "pattern": "www.agenciabyte.com", "custom_domain": true }
  ]
}
